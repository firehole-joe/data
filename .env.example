APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Shared passphrase gating the distributor credential admin UI.
FEED_ADMIN_PASSPHRASE=firehole2026

# Zanders Sporting Goods FTP feed. Host / user / path have working
# defaults in config/distributors.php; set at least the password here.
ZANDERS_FTP_HOST=ftp2.gzanders.com
ZANDERS_FTP_PORT=21
ZANDERS_FTP_USER=DarkHills
ZANDERS_FTP_PASSWORD=
ZANDERS_FTP_PATH=Inventory/zandersinv.csv

# Chattanooga Shooting Supplies REST feed (api.chattanoogashooting.com).
# The driver calls GET /items/product-feed, authenticating as
# Basic base64(SID:md5(TOKEN)), then downloads the CSV export it names.
# The base URL has a working default in config/distributors.php; set the
# SID and token here.
CHATTANOOGA_API_URL=https://api.chattanoogashooting.com/rest/v6/
CHATTANOOGA_SID=
CHATTANOOGA_TOKEN=

# Davidson's SFTP feed (ftp.davidsons.com). The driver merges the
# current-generation V2_Itemspec.csv + V2_Qty.csv by ItemNo; the legacy
# Itemspec.csv / Qty.csv are retired and never requested. Host / port
# have working defaults in config/distributors.php; set the credentials.
DAVIDSONS_SFTP_HOST=ftp.davidsons.com
DAVIDSONS_SFTP_PORT=22
DAVIDSONS_SFTP_USERNAME=
DAVIDSONS_SFTP_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
